{
    "name":  "dsh-yu-bili",
    "version":  "2.1.2",
    "description":  "DSH 刷B站插件：谷时浏览、读字幕和评论、写日报，并把有价值的经历交给人格素材入口。",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "bilibili",
                     "mcp",
                     "duty"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Speraymer/dsh-yu-bili.git"
                   },
    "homepage":  "https://github.com/Speraymer/dsh-yu-bili#readme",
    "bugs":  {
                 "url":  "https://github.com/Speraymer/dsh-yu-bili/issues"
             },
    "license":  "MIT",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "lib",
                  "prompts",
                  "vendor",
                  "CHANGELOG.md",
                  "README.md",
                  "AGENTS.md",
                  "selfcheck.mjs",
                  "LICENSE",
                  "NOTICE.md"
              ],
    "scripts":  {
                    "test":  "node --test && node selfcheck.mjs"
                },
    "engines":  {
                    "dsh":  "\u003e=0.1.7-rc.1",
                    "node":  "\u003e=22"
                },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  "*",
                             "@deepseek-ai/schemastery":  "*"
                         },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.1"
                     },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/schemastery":  {
                                                                  "optional":  true
                                                              }
                             },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "slots"
                                          ]
                           }
            },
    "publishConfig":  {
                          "access":  "public",
                          "registry":  "https://registry.npmjs.org/"
                      }
}
